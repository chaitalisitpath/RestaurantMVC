@model IEnumerable<RestaurantMVC.Models.MenuModel>
@{
	ViewData["Title"] = "Menu";
}
<h2 class="ms-5">@ViewBag.WelcomeMessage</h2>
<h1 class="text-center mt-5">Menu</h1>
<div class="mt-4">
	<table class="table mx-auto w-50">
		<thead>
			<tr>
				<th>@Html.DisplayNameFor(model => model.DishName)</th>
				<th>@Html.DisplayNameFor(model => model.Price)</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.DishName</td>
					<td>@item.Price</td>
				</tr>
			}
		</tbody>
	</table>
</div>



